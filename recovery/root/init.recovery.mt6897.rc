# Recovery init for Infinix X6873 (MT6897)
#
# Kept as close to stock as possible. Stock init.recovery.mt6897.rc does
# exactly three things:
#   - sets sys.usb.configfs 1
#   - sets sys.usb.controller to 11201000.usb0
#   - runs /system/bin/mtk_plpath_utils on boot
#
# The stock file also imports /init.recovery.project.rc, which does not exist
# in a TWRP ramdisk; importing a missing file makes init log an error and can
# abort the stage, so that import is omitted.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"

on boot
    # Creates /dev/block/by-name symlinks for the logical partitions.
    # Without this, TWRP may not find system/vendor/product inside super.
    exec u:r:recovery:s0 root root -- /system/bin/mtk_plpath_utils

    # Backlight: the panel driver exposes lcd-backlight. Make it writable so
    # the TWRP brightness control works.
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0644 /sys/class/leds/lcd-backlight/brightness
